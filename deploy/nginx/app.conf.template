# Reverse proxy, TLS termination and the front door lock.
#
# The app behind this has no authentication of its own: every route, including
# POST /api/settings, is open to whatever can reach port 8000. This file is the
# access control, not decoration. Never publish the app container's port.
#
# ${APP_DOMAIN} is substituted by the nginx image's envsubst entrypoint, which
# is restricted to the APP_ prefix so nginx's own $host and $scheme survive.

server {
    listen 80;
    listen [::]:80;
    server_name ${APP_DOMAIN};

    # The ACME challenge must stay on plain HTTP and unauthenticated, so it is
    # matched before the redirect below. Certbot writes into this webroot.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 308 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${APP_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "DENY" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;

    # APP_AUTH_REALM is either a bare realm name, which turns the password on,
    # or the literal off, which turns it off. Not quoted: nginx reads a quoted
    # "off" as a realm named off and would keep prompting.
    auth_basic           ${APP_AUTH_REALM};
    auth_basic_user_file /etc/nginx/.htpasswd;

    server_tokens off;

    gzip              on;
    gzip_vary         on;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_types        text/plain text/css application/javascript application/json image/svg+xml;

    # Settings payloads are a few hundred bytes. Nothing here accepts uploads.
    client_max_body_size 1m;

    # Renewing the certificate keeps the ACME path reachable over https too,
    # since Let's Encrypt follows the 308 above on validation retries.
    location /.well-known/acme-challenge/ {
        auth_basic off;
        root /var/www/certbot;
    }

    location / {
        # Resolve the app container at request time through Docker's embedded
        # DNS. Without this nginx caches the container IP from startup and
        # serves 502s after the app is recreated with a new address.
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $app_upstream app;
        proxy_pass http://$app_upstream:8000$request_uri;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        # The instrument master download and long candle pulls can outlast the
        # 60s default.
        proxy_connect_timeout 10s;
        proxy_read_timeout    180s;
        proxy_send_timeout    180s;
    }
}
