# TLS termination and the front door lock for a public deployment.
#
# The app behind this proxy has no authentication of its own: every route,
# including POST /api/settings, is open to whoever can reach port 8000. So the
# proxy is not decoration, it is the access control. Never publish the app
# container's port alongside this.

{
	email {$ACME_EMAIL}
	# The admin API listens on 2019 with no auth. Nothing here uses it.
	admin off
}

{$APP_DOMAIN} {
	# Certificates are issued and renewed automatically over ACME, which needs
	# ports 80 and 443 reachable from the internet and APP_DOMAIN resolving here.

	basic_auth {
		# bcrypt hash, not a password. Generate it with:
		#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'secret'
		{$APP_USER} {$APP_PASSWORD_HASH}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# The chart bundle is 845 kB uncompressed and compresses to about 240 kB.
	encode zstd gzip

	reverse_proxy app:8000 {
		health_uri /api/health
		health_interval 30s
	}

	log {
		output stdout
		format json
	}
}
