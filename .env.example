# Production settings for docker-compose.prod.yml.
# Copy to .env on the server and fill in. .env is gitignored: it holds the
# password hash and must never be committed.
#
#   cp .env.example .env

# The domain this deployment answers on. Its DNS A or AAAA record must already
# point at this server, and ports 80 and 443 must be reachable, or Caddy cannot
# complete the ACME challenge and no certificate is issued.
APP_DOMAIN=charts.example.com

# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=you@example.com

# The front door login. The app itself has no user accounts; this is the only
# thing standing between the internet and your Upstox credentials.
APP_USER=trader

# A bcrypt hash, never the password itself. Generate one, already $-escaped for
# compose, with:
#
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password' | sed 's/\$/$$/g'
#
# Every $ must appear doubled here. Compose collapses $$ back to $ before Caddy
# sees it; a single $ is read as a variable reference and silently mangles the
# hash, which fails as a wrong password with no useful error.
APP_PASSWORD_HASH=

# Container clock. Upstox tokens expire at 3:30 AM IST and candle timestamps
# are IST, so a server on UTC still reports the right expiry with this set.
TZ=Asia/Kolkata
