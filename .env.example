# Production settings for docker-compose.prod.yml.
# Copy to .env on the server and fill in. .env is gitignored.
#
#   cp .env.example .env

# The domain this deployment answers on. Its A record must already point at
# this server and must not be proxied behind a CDN when the certificate is
# issued, or Let's Encrypt cannot reach the challenge. Ports 80 and 443 have to
# be open: 80 is not optional, the ACME challenge uses it.
APP_DOMAIN=charts.example.com

# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=you@example.com

# The front door username. The app itself has no user accounts, so this is the
# only thing between the internet and your Upstox credentials.
#
# The password is not kept here. deploy/bootstrap-tls.sh generates one, prints
# it once, and writes the hash to deploy/htpasswd, which nginx reads directly.
# Change it later with:
#
#   docker run --rm httpd:2.4-alpine htpasswd -nbB USER 'newpassword' > deploy/htpasswd
#   docker compose -f docker-compose.prod.yml exec nginx nginx -s reload
APP_USER=trader

# Front door password switch.
#   Restricted (or any bare word)  password required, the safe default
#   off                            anyone with the URL gets straight in
#
# Only set this to off for a throwaway demo box, and know what it exposes:
# GET /api/settings returns your Upstox API key in clear text, and anyone can
# POST /api/settings to overwrite your credentials or POST /api/auth/logout to
# end your session. There are no order endpoints, so nobody can trade with it.
# Changing this needs an nginx recreate, not just a reload, because the value
# is baked into the config at container start:
#   docker compose -f docker-compose.prod.yml up -d --force-recreate nginx
APP_AUTH_REALM=Restricted

# Container clock. Upstox tokens expire at 3:30 AM IST and candle timestamps
# are IST, so a server on UTC still reports the right expiry with this set.
TZ=Asia/Kolkata

# Resource ceiling for the app container. cpus must not exceed the host's core
# count or Docker refuses to start it. Defaults suit a 1 vCPU / 1 GB VPS.
#APP_CPUS=1.0
#APP_MEMORY=768M

# Which address port 80 is published on.
#   0.0.0.0    reachable from the internet. Required for HTTP-01 renewal.
#   127.0.0.1  loopback only. Breaks HTTP-01 renewal, see below.
#
# Do not set this to 127.0.0.1 while using HTTP-01 (the default here), even
# behind a CDN. Measured against Cloudflare in Full mode: the CDN preserves the
# scheme to the origin, so the challenge, which the CDN deliberately exempts
# from its HTTPS redirect, arrives on origin port 80 and nowhere else. With 80
# closed, renewal fails with a 522 from the CDN and the certificate quietly
# expires. Serving the challenge on 443 as well does not rescue it, because the
# request never reaches 443.
#
# Only useful if you switch to DNS-01 validation, which needs no inbound port.
#HTTP_BIND_ADDR=0.0.0.0
